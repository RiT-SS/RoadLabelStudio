# Copy to .env on the server. Do not commit credentials.
STUDIO_DOMAIN=label.example.com
STUDIO_PUBLIC_URL=https://label.example.com
# Required for production; use a long, unique password (12+ characters).
STUDIO_PASSWORD=
STUDIO_MAX_UPLOAD_MB=1024
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# A vision-capable model is required. Plain text Qwen models cannot inspect frames.
# On Linux Docker, use host.docker.internal:port for a host-side private service.
QWEN_BASE_URL=
QWEN_MODEL=Qwen2.5-VL-3B-Instruct
QWEN_API_KEY=
# Native deployment: let the website own the local 3B model subprocess.
# Keep 0 for external services or the lightweight Docker image without CUDA.
QWEN_AUTO_MANAGE=0
QWEN_IDLE_SECONDS=600
STUDIO_PRESENCE_SECONDS=90
QWEN_LOAD_TIMEOUT_SECONDS=300
QWEN_GPU_IDS=auto
QWEN_MODEL_PATH=./models/Qwen2.5-VL-3B-Instruct
